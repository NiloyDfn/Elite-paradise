{
  "name": "elite-paradise",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "node scripts/build-server.mjs",
    "start": "node dist/index.js",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-label": "2.1.12",
    "@radix-ui/react-slot": "1.3.0",
    "@tanstack/react-query": "5.101.4",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "express": "^5.3.0",
    "gsap": "^3.15.1",
    "jose": "6.2.3",
    "lucide-react": "1.25.0",
    "mongoose": "^9.12.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.1",
    "superjson": "2.2.6",
    "tailwind-merge": "3.6.0",
    "wouter": "3.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "esbuild": "0.28.1",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
