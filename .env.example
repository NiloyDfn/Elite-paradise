# Copy this file to ".env" (no extension) and fill it in. Never upload .env to GitHub.

# 1) Your MongoDB Atlas connection string (Atlas → Connect → Drivers).
#    Replace <password> with your real password (no < > brackets!) and add a
#    database name before the "?" — for example /eliteparadise
MONGODB_URI=mongodb+srv://foysalahamedniloy1235_db_user:TAMh0pszCP4IKDSP@cluster0.qwr9bqt.mongodb.net

# 2) A long random text. Used to sign login cookies. Make your own, e.g. run:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=elite_paradise_secret_long_text

# 3) Your admin login. On every start the server makes sure this admin exists.
#    (If the email already has a normal account, it is promoted to admin.)
ADMIN_EMAIL=foysalahamedniloy1235@gmail.com 
ADMIN_PASSWORD=admin@1235

# Optional
# PORT=3000              # Render sets this for you
# SEED_ON_START=false    # set to false to NOT load the 24 sample products
